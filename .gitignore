# Swift Package Manager build artifacts (e.g. from `swift build` / `swift test`
# inside LocalPackages/*)
.build/
.swiftpm/

# Xcode
DerivedData/
*.xcuserstate
xcuserdata/
build/

# macOS
.DS_Store

# local package resolutions (app workspace Package.resolved is authoritative)
LocalPackages/**/Package.resolved

# Vosk acoustic model — added manually per machine, never committed (100s of MB).
# Keep the folder + its README; ignore any actual model dropped inside.
Models/*
!Models/README.md
